PORT=4000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Email transacional. Sem SMTP, os links ficam registrados em mail_outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arena Camp <no-reply@example.com>

# Login social. Cadastre exatamente os callbacks abaixo em cada provedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/oauth/discord/callback
STEAM_API_KEY=
STEAM_REDIRECT_URI=http://localhost:4000/auth/oauth/steam/callback
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Public HTTPS address of this API in production.
# Em producao, substitua por uma URL HTTPS publica.
# PUBLIC_API_URL=https://api.example.com

# Optional explicit receiver. Takes precedence over PUBLIC_API_URL.
MP_WEBHOOK_URL=https://api.example.com/payment/webhook

# Secret signature shown in Mercado Pago > Your integrations > Webhooks.
MP_WEBHOOK_SECRET=
PAYMENT_RECONCILIATION_INTERVAL_MS=15000
